// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model StroopSession {
  id                               String   @id @default(cuid())
  userId                           String
  timestamp                        DateTime @default(now())

  // Round 1
  round1Id                         String?
  round1Title                      String?
  round1Score                      Int?
  round1Trials                     Int?
  round1AverageResponseTimeSeconds Float?

  // Round 2
  round2Id                         String?
  round2Title                      String?
  round2Score                      Int?
  round2Trials                     Int?
  round2AverageResponseTimeSeconds Float?

  overallAccuracy                  Float?
  totalGameTimeSeconds             Int?
}
